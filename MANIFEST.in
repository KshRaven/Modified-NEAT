include README.md
include LICENSE
include requirements.txt
include ModifiedNEAT/dashboard/backend/requirements.txt
recursive-include ModifiedNEAT/dashboard/dist *
# Never ship frontend sources, dependencies, configs, caches or tests
prune ModifiedNEAT/dashboard/src
prune ModifiedNEAT/dashboard/node_modules
prune ModifiedNEAT/dashboard/backend/testing
exclude ModifiedNEAT/dashboard/bun.lock
exclude ModifiedNEAT/dashboard/package.json
exclude ModifiedNEAT/dashboard/*.config.*
exclude ModifiedNEAT/dashboard/tsconfig*.json
exclude ModifiedNEAT/dashboard/.env*
global-exclude __pycache__ *.py[cod] *.map *.log *.pkl *.pt *.pth .env .env.* *.pem *.key .DS_Store
